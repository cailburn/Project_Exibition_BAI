# Flask Application Configuration
FLASK_APP=run.py
FLASK_ENV=development
PORT=5000
SECRET_KEY=change_me_to_a_secure_random_key_in_production

# CORS Configuration (comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Database Configuration
# Supported DATABASE_TYPE options: "mysql" (default for team/prod), "sqlite" (only if explicitly configured for local testing)
DATABASE_TYPE=mysql
MYSQL_USER=customchurn_user
MYSQL_PASSWORD=your_password_here
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=customchurn_db

# ML Model Configuration
# Path relative to backend/ directory or absolute path
ML_MODEL_PATH=app/ml_models/churn_model.joblib
